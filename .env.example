# Copier vers .env.local pour `npm run dev`, ou vers .env pour Docker local.
# Ne jamais committer les vraies clés.
# Production Hostinger : voir `.env.hostinger.example`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret serveur (sb_secret_…). Jamais NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Ancien nom encore accepté (JWT service_role). Préférer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

CONTACT_TO_EMAIL=commercial@infolog.mr

# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=INFOLOG <noreply@infolog.mr>

# --- Docker local ---
# PUBLIC_HOST=infolog.localhost
# ADMIN_HOST=admin.infolog.localhost
# SITE_URL=http://infolog.localhost
# ADMIN_URL=http://admin.infolog.localhost
# ENABLE_HTTPS_REDIRECT=0
