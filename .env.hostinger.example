# Copier vers .env sur le VPS Hostinger. Ne jamais committer les vraies clés.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CONTACT_TO_EMAIL=commercial@infolog.mr
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=INFOLOG <noreply@infolog.mr>

PUBLIC_HOST=infolog.digital
ADMIN_HOST=admin.infolog.digital
SITE_URL=https://infolog.digital
ADMIN_URL=https://admin.infolog.digital

# 0 tant que Let's Encrypt n'est pas passé. issue-certs.sh passe à 1.
ENABLE_HTTPS_REDIRECT=0

SSL_CERTIFICATE=/etc/letsencrypt/live/infolog.digital/fullchain.pem
SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/infolog.digital/privkey.pem

LETSENCRYPT_EMAIL=commercial@infolog.mr
